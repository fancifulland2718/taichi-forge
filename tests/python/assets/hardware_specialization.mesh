#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x_id = 0) in;
layout(constant_id = 1) const bool rgb = false;
layout(triangles, max_vertices = 3, max_primitives = 1) out;
layout(set = 0, binding = 0) readonly buffer Color { vec4 value; } color;
layout(location = 0) out vec3 out_color[];
void main() {
  SetMeshOutputsEXT(3, 1);
  if (gl_LocalInvocationIndex == 0) {
    gl_MeshVerticesEXT[0].gl_Position = vec4(-1, -1, 0, 1);
    gl_MeshVerticesEXT[1].gl_Position = vec4(3, -1, 0, 1);
    gl_MeshVerticesEXT[2].gl_Position = vec4(-1, 3, 0, 1);
    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
    for (int i = 0; i < 3; ++i)
      out_color[i] = rgb ? color.value.rgb : color.value.bgr;
  }
}
