#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;
layout(triangles, max_vertices = 3, max_primitives = 1) out;
layout(location = 0) out vec3 out_color[];

void main() {
  SetMeshOutputsEXT(3, 1);
  gl_MeshVerticesEXT[0].gl_Position = vec4(0.0, 0.6, 0.0, 1.0);
  gl_MeshVerticesEXT[1].gl_Position = vec4(0.6, -0.6, 0.0, 1.0);
  gl_MeshVerticesEXT[2].gl_Position = vec4(-0.6, -0.6, 0.0, 1.0);
  gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
  out_color[0] = vec3(1.0, 0.0, 0.0);
  out_color[1] = vec3(0.0, 1.0, 0.0);
  out_color[2] = vec3(0.0, 0.0, 1.0);
}
