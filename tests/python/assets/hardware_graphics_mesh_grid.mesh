#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;
layout(triangles, max_vertices = 3, max_primitives = 1) out;
layout(location = 0) out vec3 out_color[];

void main() {
  const uint grid_width = 128;
  uint cell_x = gl_WorkGroupID.x % grid_width;
  uint cell_y = gl_WorkGroupID.x / grid_width;
  vec2 center = (vec2(cell_x, cell_y) + vec2(0.5)) / 64.0 - vec2(1.0);
  vec2 radius = vec2(0.006);
  SetMeshOutputsEXT(3, 1);
  gl_MeshVerticesEXT[0].gl_Position =
      vec4(center + vec2(0.0, radius.y), 0.0, 1.0);
  gl_MeshVerticesEXT[1].gl_Position =
      vec4(center + vec2(radius.x, -radius.y), 0.0, 1.0);
  gl_MeshVerticesEXT[2].gl_Position =
      vec4(center + vec2(-radius.x, -radius.y), 0.0, 1.0);
  gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
  out_color[0] = vec3(1.0, 0.0, 0.0);
  out_color[1] = vec3(0.0, 1.0, 0.0);
  out_color[2] = vec3(0.0, 0.0, 1.0);
}
