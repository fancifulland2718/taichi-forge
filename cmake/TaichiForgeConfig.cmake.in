get_filename_component(_ti_sdk_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT TARGET TaichiForge::c_api)
    add_library(TaichiForge::c_api SHARED IMPORTED)
    if(WIN32)
        set_target_properties(TaichiForge::c_api PROPERTIES
            IMPORTED_LOCATION "${_ti_sdk_prefix}/bin/taichi_c_api.dll"
            IMPORTED_IMPLIB "${_ti_sdk_prefix}/lib/taichi_c_api.lib")
    else()
        set_target_properties(TaichiForge::c_api PROPERTIES
            IMPORTED_LOCATION "${_ti_sdk_prefix}/lib/@CMAKE_SHARED_LIBRARY_PREFIX@taichi_c_api@CMAKE_SHARED_LIBRARY_SUFFIX@")
    endif()
    set_target_properties(TaichiForge::c_api PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_ti_sdk_prefix}/include")
endif()
set(TaichiForge_VERSION "@TAICHI_SDK_VERSION@")
set(TaichiForge_RUNTIME_DIR "${_ti_sdk_prefix}/runtime")
set(TaichiForge_MANIFEST "${_ti_sdk_prefix}/sdk_manifest.json")
unset(_ti_sdk_prefix)
