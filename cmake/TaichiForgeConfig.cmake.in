get_filename_component(_ti_sdk_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT TARGET TaichiForge::c_api)
    add_library(TaichiForge::c_api SHARED IMPORTED)
    if(WIN32)
        set_target_properties(TaichiForge::c_api PROPERTIES
            IMPORTED_LOCATION "${_ti_sdk_prefix}/bin/@TAICHI_SDK_LIBRARY_NAME@.dll"
            IMPORTED_IMPLIB "${_ti_sdk_prefix}/lib/@TAICHI_SDK_LIBRARY_NAME@.lib")
    else()
        set_target_properties(TaichiForge::c_api PROPERTIES
            IMPORTED_LOCATION "${_ti_sdk_prefix}/lib/@CMAKE_SHARED_LIBRARY_PREFIX@@TAICHI_SDK_LIBRARY_NAME@@CMAKE_SHARED_LIBRARY_SUFFIX@")
    endif()
    set_target_properties(TaichiForge::c_api PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_ti_sdk_prefix}/include")
endif()
set(TaichiForge_VERSION "@TAICHI_SDK_VERSION@")
set(TaichiForge_RUNTIME_C_API @TAICHI_SDK_RUNTIME_C_API@)
set(TaichiForge_RUNTIME_DIR "${_ti_sdk_prefix}/runtime")
set(TaichiForge_MANIFEST "${_ti_sdk_prefix}/sdk_manifest.json")
if(WIN32)
    set(TaichiForge_PROVIDER_DIR "${_ti_sdk_prefix}/bin/hardware_providers")
else()
    set(TaichiForge_PROVIDER_DIR "${_ti_sdk_prefix}/lib/hardware_providers")
endif()
set(TaichiForge_PROVIDER_MANIFEST_DIR "${_ti_sdk_prefix}/share/taichi/providers")
unset(_ti_sdk_prefix)
