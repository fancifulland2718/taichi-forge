set(_prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_files "")
set(_separator "")
set(_total 0)
foreach(_file IN LISTS CMAKE_INSTALL_MANIFEST_FILES)
    set(_file "$ENV{DESTDIR}${_file}")
    file(RELATIVE_PATH _relative "${_prefix}" "${_file}")
    if(_relative MATCHES "^\\.\\." OR IS_DIRECTORY "${_file}")
        continue()
    endif()
    file(SHA256 "${_file}" _sha)
    file(SIZE "${_file}" _size)
    math(EXPR _total "${_total} + ${_size}")
    string(REPLACE "\\" "/" _relative "${_relative}")
    string(APPEND _files "${_separator}\n    {\"path\":\"${_relative}\",\"bytes\":${_size},\"sha256\":\"${_sha}\"}")
    set(_separator ",")
endforeach()
file(WRITE "${_prefix}/sdk_manifest.json"
"{\n  \"schema_version\":1,\n  \"version\":\"@TAICHI_SDK_VERSION@\",\n  \"source_revision_at_configure\":\"@TAICHI_SDK_SOURCE_REVISION@\",\n  \"system\":\"@CMAKE_SYSTEM_NAME@\",\n  \"processor\":\"@CMAKE_SYSTEM_PROCESSOR@\",\n  \"llvm_version\":\"@LLVM_PACKAGE_VERSION@\",\n  \"native_library\":\"@TAICHI_SDK_LIBRARY_NAME@\",\n  \"build_features\":{\"llvm\":@TAICHI_SDK_LLVM@,\"cuda\":@TAICHI_SDK_CUDA@,\"vulkan\":@TAICHI_SDK_VULKAN@,\"runtime_c_api\":@TAICHI_SDK_RUNTIME_C_API@},\n  \"artifact_boundary\":\"ordinary kernels, CGraphs and versioned execution plans; registered native operations and resources are reconstructed under their qualified backend contracts\",\n  \"external_requirements\":[\"platform C/C++ runtime\",\"GPU driver for selected backend\"],\n  \"installed_payload_bytes\":${_total},\n  \"files\":[${_files}\n  ]\n}\n")
