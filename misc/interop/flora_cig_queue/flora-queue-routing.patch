+++ b/src/Interop/ComputeQueue.h
@@ -0,0 +1,17 @@
+#pragma once
+#include <nvrhi/nvrhi.h>
+
+namespace flora::interop {
+// CiG reserves the graphics family for graphics and external CUDA work.
+// The owner enables a dedicated compute queue before creating any resources.
+inline nvrhi::CommandQueue work_queue(nvrhi::IDevice* device) {
+    return device->queryFeatureSupport(nvrhi::Feature::ComputeQueue)
+        ? nvrhi::CommandQueue::Compute : nvrhi::CommandQueue::Graphics;
+}
+inline nvrhi::CommandListHandle create_work_command(nvrhi::IDevice* device) {
+    return device->createCommandList(nvrhi::CommandListParameters().setQueueType(work_queue(device)));
+}
+inline uint64_t submit_work(nvrhi::IDevice* device, nvrhi::ICommandList* command) {
+    return device->executeCommandList(command, command->getDesc().queueType);
+}
+}
