#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Flags {
  int data[];
} flags_buf;

layout(set = 0, binding = 1, std430) buffer Prefix {
  int data[];
} prefix_buf;

void main() {
  uint idx = gl_GlobalInvocationID.x;
  uint n = flags_buf.data.length();
  if (idx >= n) {
    return;
  }
  prefix_buf.data[idx] = flags_buf.data[idx] != 0 ? 1 : 0;
}
