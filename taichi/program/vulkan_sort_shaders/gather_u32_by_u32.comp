#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Src {
  uint data[];
} src_buf;

layout(set = 0, binding = 1, std430) readonly buffer Indices {
  uint data[];
} indices_buf;

layout(set = 0, binding = 2, std430) writeonly buffer Dst {
  uint data[];
} dst_buf;

void main() {
  uint word_i = gl_GlobalInvocationID.x;
  uint dst_words = dst_buf.data.length();
  if (word_i >= dst_words) {
    return;
  }
  uint item_count = indices_buf.data.length();
  if (item_count == 0u) {
    return;
  }
  uint item_words = dst_words / item_count;
  uint item = word_i / item_words;
  uint lane = word_i - item * item_words;
  uint index = indices_buf.data[item];
  uint src_items = src_buf.data.length() / item_words;
  if (index >= src_items) {
    dst_buf.data[word_i] = 0u;
    return;
  }
  dst_buf.data[word_i] = src_buf.data[index * item_words + lane];
}
