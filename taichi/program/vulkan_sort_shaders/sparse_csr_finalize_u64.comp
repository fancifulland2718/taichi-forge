#version 450
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer UniqueKeys {
  uint64_t unique_keys[];
};
layout(set = 0, binding = 1) writeonly buffer ColumnIndices {
  int column_indices[];
};
layout(set = 0, binding = 2) buffer RowOffsets {
  int row_offsets[];
};
layout(set = 0, binding = 3) readonly buffer ActiveCount {
  int active_count[];
};
layout(set = 0, binding = 4) buffer Control {
  int control[];
};

layout(push_constant) uniform Params {
  uint capacity;
  uint num_rows;
  uint num_columns;
  uint reserved;
} params;

void set_status(int value) {
  atomicCompSwap(control[0], 0, -value);
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  int active_items = active_count[0];
  int count = control[1];
  if (active_items < 0 || uint(active_items) > params.capacity || count < 0 ||
      count > active_items) {
    if (i == 0u) {
      set_status(4);
    }
    return;
  }
  if (active_items == 0) {
    return;
  }
  if (i >= uint(count)) {
    return;
  }
  uint64_t key = unique_keys[i];
  uint row = uint(key >> 32);
  uint column = uint(key);
  if (row >= params.num_rows || column >= params.num_columns) {
    set_status(4);
    return;
  }
  column_indices[i] = int(column);
  atomicAdd(row_offsets[row + 1u], 1);
}
