#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Values {
  int data[];
} values_buf;

layout(set = 0, binding = 1, std430) buffer Flags {
  int data[];
} flags_buf;

layout(set = 0, binding = 2, std430) buffer Prefix {
  int data[];
} prefix_buf;

layout(set = 0, binding = 3, std430) buffer Output {
  int data[];
} output_buf;

layout(set = 0, binding = 4, std430) buffer Count {
  int data[];
} count_buf;

void main() {
  uint idx = gl_GlobalInvocationID.x;
  uint n = values_buf.data.length();
  if (idx == 0u) {
    count_buf.data[0] = n > 0u ? prefix_buf.data[n - 1u] : 0;
  }
  if (idx >= n) {
    return;
  }
  if (flags_buf.data[idx] != 0) {
    uint out_idx = uint(prefix_buf.data[idx] - 1);
    output_buf.data[out_idx] = values_buf.data[idx];
  }
}
