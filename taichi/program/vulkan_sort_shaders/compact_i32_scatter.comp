#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Values {
  uint data[];
} values_buf;

layout(set = 0, binding = 1, std430) buffer Flags {
  int data[];
} flags_buf;

layout(set = 0, binding = 2, std430) buffer Prefix {
  int data[];
} prefix_buf;

layout(set = 0, binding = 3, std430) buffer Output {
  uint data[];
} output_buf;

layout(set = 0, binding = 4, std430) buffer Count {
  int data[];
} count_buf;

void main() {
  uint word_idx = gl_GlobalInvocationID.x;
  uint n = flags_buf.data.length();
  uint value_words = values_buf.data.length();
  if (word_idx == 0u) {
    count_buf.data[0] = n > 0u ? prefix_buf.data[n - 1u] : 0;
  }
  if (n == 0u || word_idx >= value_words) {
    return;
  }
  uint item_words = value_words / n;
  uint item = word_idx / item_words;
  uint lane = word_idx - item * item_words;
  if (flags_buf.data[item] != 0) {
    uint out_idx = uint(prefix_buf.data[item] - 1);
    output_buf.data[out_idx * item_words + lane] = values_buf.data[word_idx];
  }
}
