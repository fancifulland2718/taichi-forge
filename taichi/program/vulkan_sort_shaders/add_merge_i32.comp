#version 450

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 1
#define VALUE_T float
#elif VALUE_KIND == 2
#define VALUE_T uint
#elif VALUE_KIND == 3
#extension GL_ARB_gpu_shader_int64 : require
#define VALUE_T uint64_t
#elif VALUE_KIND == 4
#extension GL_ARB_gpu_shader_int64 : require
#define VALUE_T int64_t
#elif VALUE_KIND == 5
#extension GL_ARB_gpu_shader_fp64 : require
#define VALUE_T double
#else
#define VALUE_T int
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Src {
  VALUE_T data[];
} src_buf;

layout(set = 0, binding = 1, std430) buffer Dst {
  VALUE_T data[];
} dst_buf;

layout(push_constant) uniform Params {
  uint n;
  uint src_offset_items;
  uint src_stride_items;
  uint dst_offset_items;
  uint dst_stride_items;
  uint unused0;
} params_buf;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= params_buf.n) {
    return;
  }
  uint src_index = params_buf.src_offset_items + i * params_buf.src_stride_items;
  uint dst_index = params_buf.dst_offset_items + i * params_buf.dst_stride_items;
  dst_buf.data[dst_index] += src_buf.data[src_index];
}
