#version 450

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 1
#extension GL_EXT_shader_atomic_float : require
#define VALUE_T float
#elif VALUE_KIND == 2
#define VALUE_T uint
#elif VALUE_KIND == 3
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#define VALUE_T uint64_t
#elif VALUE_KIND == 4
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#define VALUE_T int64_t
#elif VALUE_KIND == 5
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_atomic_float : require
#define VALUE_T double
#else
#define VALUE_T int
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Src {
  VALUE_T data[];
} src_buf;

layout(set = 0, binding = 1, std430) readonly buffer Indices {
  int data[];
} indices_buf;

layout(set = 0, binding = 2, std430) buffer Dst {
  VALUE_T data[];
} dst_buf;

#ifdef STRIDED_SOURCE
layout(push_constant) uniform Params {
  uint n;
  uint src_offset_items;
  uint src_stride_items;
  uint dst_count;
  uint dst_offset_items;
  uint dst_stride_items;
} params_buf;

uint value_count() {
  return params_buf.n;
}

VALUE_T load_value(uint i) {
  return src_buf.data[params_buf.src_offset_items + i * params_buf.src_stride_items];
}

uint destination_count() {
  return params_buf.dst_count;
}

uint destination_index(uint i) {
  return params_buf.dst_offset_items + i * params_buf.dst_stride_items;
}
#else
uint value_count() {
  return uint(src_buf.data.length());
}

VALUE_T load_value(uint i) {
  return src_buf.data[i];
}

uint destination_count() {
  return uint(dst_buf.data.length());
}

uint destination_index(uint i) {
  return i;
}
#endif

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= value_count()) {
    return;
  }
  int index = indices_buf.data[i];
  uint logical_index = uint(index);
  if (index < 0 || logical_index >= destination_count()) {
    return;
  }
  uint dst_index = destination_index(logical_index);
  atomicAdd(dst_buf.data[dst_index], load_value(i));
}
