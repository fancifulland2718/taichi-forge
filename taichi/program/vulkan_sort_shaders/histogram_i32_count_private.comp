#version 450

layout(local_size_x = 256) in;
layout(push_constant) uniform HistogramParams {
  uint n;
  uint num_bins;
  uint values_offset;
  uint bins_offset;
  uint num_chunks;
} params;


#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#ifndef BIN_KIND
#define BIN_KIND 0
#endif

#if BIN_KIND == 4
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#define BIN_T int64_t
#else
#define BIN_T int
#endif

#if VALUE_KIND == 2
#define VALUE_T uint
#else
#define VALUE_T int
#endif

layout(set = 0, binding = 0, std430) buffer Values {
  VALUE_T data[];
} values_buf;

layout(set = 0, binding = 1, std430) buffer Partial {
  BIN_T data[];
} partial_buf;

void main() {
  const uint chunk_size = 2048u;
  uint idx = gl_GlobalInvocationID.x;
  uint n = params.n;
  uint num_bins = params.num_bins;
  if (idx >= n) {
    return;
  }
#if VALUE_KIND == 2
  uint bin = values_buf.data[params.values_offset + idx];
  if (bin < num_bins) {
    uint chunk = idx / chunk_size;
    atomicAdd(partial_buf.data[chunk * num_bins + bin], BIN_T(1));
  }
#else
  VALUE_T bin = values_buf.data[params.values_offset + idx];
  if (bin >= 0 && uint(bin) < num_bins) {
    uint chunk = idx / chunk_size;
    atomicAdd(partial_buf.data[chunk * num_bins + uint(bin)], BIN_T(1));
  }
#endif
}
