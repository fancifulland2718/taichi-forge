#version 450

layout(local_size_x = 256) in;

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 3 || VALUE_KIND == 4
#extension GL_ARB_gpu_shader_int64 : require
#elif VALUE_KIND == 5
#extension GL_ARB_gpu_shader_fp64 : require
#endif

#if VALUE_KIND == 1
#define VALUE_T float
#elif VALUE_KIND == 2
#define VALUE_T uint
#elif VALUE_KIND == 3
#define VALUE_T uint64_t
#elif VALUE_KIND == 4
#define VALUE_T int64_t
#elif VALUE_KIND == 5
#define VALUE_T double
#else
#define VALUE_T int
#endif

layout(set = 0, binding = 0, std430) buffer Data {
  VALUE_T data[];
} data_buf;

layout(set = 0, binding = 1, std430) readonly buffer BlockOffsets {
  VALUE_T data[];
} block_offsets;

#ifdef STRIDED_SOURCE
layout(set = 0, binding = 2, std430) readonly buffer ScanParams {
  uint n;
  uint data_offset_words;
  uint data_stride_words;
} params_buf;
#endif

uint value_count() {
#ifdef STRIDED_SOURCE
  return params_buf.n;
#else
  return data_buf.data.length();
#endif
}

uint physical_index(uint logical_index) {
#ifdef REVERSE_SCAN
  uint n = value_count();
  return n - 1u - logical_index;
#else
  return logical_index;
#endif
}

VALUE_T load_value(uint logical_index) {
  uint data_index = physical_index(logical_index);
#ifdef STRIDED_SOURCE
  uint word_index =
      params_buf.data_offset_words + data_index * params_buf.data_stride_words;
#if VALUE_KIND == 3 || VALUE_KIND == 4 || VALUE_KIND == 5
  return data_buf.data[word_index / 2u];
#else
  return data_buf.data[word_index];
#endif
#else
  return data_buf.data[data_index];
#endif
}

void store_value(uint logical_index, VALUE_T value) {
  uint data_index = physical_index(logical_index);
#ifdef STRIDED_SOURCE
  uint word_index =
      params_buf.data_offset_words + data_index * params_buf.data_stride_words;
#if VALUE_KIND == 3 || VALUE_KIND == 4 || VALUE_KIND == 5
  data_buf.data[word_index / 2u] = value;
#else
  data_buf.data[word_index] = value;
#endif
#else
  data_buf.data[data_index] = value;
#endif
}

void main() {
  uint idx = gl_GlobalInvocationID.x;
  uint n = value_count();
  if (idx >= n) {
    return;
  }

  uint block = idx / 256u;
  if (block > 0u) {
    store_value(idx, load_value(idx) + block_offsets.data[block - 1u]);
  }
}
