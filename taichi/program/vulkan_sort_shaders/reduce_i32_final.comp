#version 450

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 3 || VALUE_KIND == 4
#extension GL_ARB_gpu_shader_int64 : require
#endif

#if VALUE_KIND == 5
#extension GL_ARB_gpu_shader_fp64 : require
#endif

layout(local_size_x = 256) in;

#if VALUE_KIND == 0
#define VALUE_T int
#elif VALUE_KIND == 1
#define VALUE_T float
#elif VALUE_KIND == 2
#define VALUE_T uint
#elif VALUE_KIND == 3
#define VALUE_T uint64_t
#elif VALUE_KIND == 4
#define VALUE_T int64_t
#else
#define VALUE_T double
#endif

layout(set = 0, binding = 0, std430) buffer Partial {
  VALUE_T data[];
} partial_buf;

layout(set = 0, binding = 1, std430) buffer Output {
  VALUE_T data[];
} output_buf;

shared VALUE_T local_reduce[256];

#ifndef OP_KIND
#define OP_KIND 0
#endif

VALUE_T reduce_identity() {
#if OP_KIND == 0
  return VALUE_T(0);
#elif OP_KIND == 1
#if VALUE_KIND == 0
  return VALUE_T(2147483647);
#elif VALUE_KIND == 1
  return uintBitsToFloat(0x7f800000u);
#elif VALUE_KIND == 2
  return VALUE_T(0xffffffffu);
#elif VALUE_KIND == 3
  return ~VALUE_T(0);
#elif VALUE_KIND == 4
  return VALUE_T(9223372036854775807L);
#else
  return VALUE_T(1.0 / 0.0);
#endif
#else
#if VALUE_KIND == 0
  return VALUE_T(-2147483647 - 1);
#elif VALUE_KIND == 1
  return -uintBitsToFloat(0x7f800000u);
#elif VALUE_KIND == 2 || VALUE_KIND == 3
  return VALUE_T(0);
#elif VALUE_KIND == 4
  return VALUE_T(-9223372036854775807L - 1L);
#else
  return VALUE_T(-1.0 / 0.0);
#endif
#endif
}

VALUE_T reduce_combine(VALUE_T a, VALUE_T b) {
#if OP_KIND == 0
  return a + b;
#elif OP_KIND == 1
  return b < a ? b : a;
#else
  return b > a ? b : a;
#endif
}

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint n = partial_buf.data.length();

  VALUE_T acc = reduce_identity();
  for (uint idx = lid; idx < n; idx += 256u) {
    acc = reduce_combine(acc, partial_buf.data[idx]);
  }
  local_reduce[lid] = acc;
  barrier();

  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (lid < stride) {
      local_reduce[lid] = reduce_combine(local_reduce[lid],
                                         local_reduce[lid + stride]);
    }
    barrier();
  }

  if (lid == 0u) {
    output_buf.data[0] = local_reduce[0];
  }
}
