#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Src {
  uint data[];
} src_buf;

layout(set = 0, binding = 1, std430) writeonly buffer Dst {
  uint data[];
} dst_buf;

layout(set = 0, binding = 2, std430) readonly buffer Params {
  uint scale;
  uint bias;
  uint unused0;
  uint unused1;
  uint n;
  uint src_offset_words;
  uint src_stride_words;
} params;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= params.n) {
    return;
  }
  float value = uintBitsToFloat(src_buf.data[params.src_offset_words + i * params.src_stride_words]);
  float scale = uintBitsToFloat(params.scale);
  float bias = uintBitsToFloat(params.bias);
  dst_buf.data[i] = floatBitsToUint(value * scale + bias);
}
