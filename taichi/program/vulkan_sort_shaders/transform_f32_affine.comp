#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Src {
  uint data[];
} src_buf;

layout(set = 0, binding = 1, std430) writeonly buffer Dst {
  uint data[];
} dst_buf;

layout(push_constant) uniform Params {
  uint scale;
  uint bias;
  uint unused0;
  uint unused1;
  uint n;
  uint src_offset_words;
  uint src_stride_words;
  uint dst_offset_words;
  uint dst_stride_words;
  uint lane_count;
} params;

void main() {
  uint scalar_i = gl_GlobalInvocationID.x;
  uint total = params.n * params.lane_count;
  if (scalar_i >= total) {
    return;
  }
  uint item = scalar_i / params.lane_count;
  uint lane = scalar_i - item * params.lane_count;
  float value = uintBitsToFloat(src_buf.data[params.src_offset_words +
                                             item * params.src_stride_words + lane]);
  float scale = uintBitsToFloat(params.scale);
  float bias = uintBitsToFloat(params.bias);
  dst_buf.data[params.dst_offset_words + item * params.dst_stride_words + lane] =
      floatBitsToUint(value * scale + bias);
}
