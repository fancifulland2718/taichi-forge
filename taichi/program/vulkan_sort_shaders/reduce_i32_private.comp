#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Values {
  int data[];
} values_buf;

layout(set = 0, binding = 1, std430) buffer Partial {
  int data[];
} partial_buf;

shared int local_reduce[256];

#ifndef OP_KIND
#define OP_KIND 0
#endif

int reduce_identity() {
#if OP_KIND == 0
  return 0;
#elif OP_KIND == 1
  return 2147483647;
#else
  return (-2147483647 - 1);
#endif
}

int reduce_combine(int a, int b) {
#if OP_KIND == 0
  return a + b;
#elif OP_KIND == 1
  return min(a, b);
#else
  return max(a, b);
#endif
}

void main() {
  const uint chunk_size = 2048u;
  uint lid = gl_LocalInvocationID.x;
  uint chunk = gl_WorkGroupID.x;
  uint n = values_buf.data.length();
  uint base = chunk * chunk_size;

  int acc = reduce_identity();
  for (uint offset = lid; offset < chunk_size; offset += 256u) {
    uint idx = base + offset;
    if (idx < n) {
      acc = reduce_combine(acc, values_buf.data[idx]);
    }
  }
  local_reduce[lid] = acc;
  barrier();

  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (lid < stride) {
      local_reduce[lid] = reduce_combine(local_reduce[lid],
                                         local_reduce[lid + stride]);
    }
    barrier();
  }

  if (lid == 0u) {
    partial_buf.data[chunk] = local_reduce[0];
  }
}
