#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 1
#define VALUE_T float
#define ZERO_VALUE 0.0
#elif VALUE_KIND == 2
#define VALUE_T uint
#define ZERO_VALUE 0u
#else
#define VALUE_T int
#define ZERO_VALUE 0
#endif

layout(set = 0, binding = 0, std430) buffer Data {
  VALUE_T data[];
} data_buf;

layout(set = 0, binding = 1, std430) buffer BlockSums {
  VALUE_T data[];
} block_sums;

shared VALUE_T scratch[256];

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint block = gl_WorkGroupID.x;
  uint idx = block * 256u + lid;
  uint n = data_buf.data.length();
  uint blocks = (n + 255u) / 256u;

  VALUE_T value = idx < n ? data_buf.data[idx] : ZERO_VALUE;

  if (gl_NumSubgroups <= gl_SubgroupSize) {
    uint subgroup = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    VALUE_T inclusive = subgroupInclusiveAdd(value);
    VALUE_T total = subgroupAdd(value);
    if (subgroupElect()) {
      scratch[subgroup] = total;
    }
    barrier();

    if (subgroup == 0u) {
      VALUE_T subgroup_sum =
          lane < gl_NumSubgroups ? scratch[lane] : ZERO_VALUE;
      VALUE_T subgroup_prefix =
          subgroupInclusiveAdd(subgroup_sum) - subgroup_sum;
      if (lane < gl_NumSubgroups) {
        scratch[lane] = subgroup_prefix;
      }
    }
    barrier();
    value = inclusive + scratch[subgroup];
  } else {
    scratch[lid] = value;
    barrier();
    for (uint step = 1u; step < 256u; step <<= 1u) {
      VALUE_T addend = lid >= step ? scratch[lid - step] : ZERO_VALUE;
      barrier();
      scratch[lid] += addend;
      barrier();
    }
    value = scratch[lid];
  }

  if (idx < n) {
    data_buf.data[idx] = value;
  }
  if (blocks > 1u && (lid == 255u || idx + 1u == n)) {
    block_sums.data[block] = value;
  }
}
