#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256) in;
#include "bucket_params.glsl"

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 7
#define VALUE_T uint
#elif VALUE_KIND == 6
#define VALUE_T uvec2
#elif VALUE_KIND == 2
#define VALUE_T uint
#elif VALUE_KIND == 1
#define VALUE_T float
#else
#define VALUE_T int
#endif

layout(set = 0, binding = 0, std430) readonly buffer Keys {
  int data[];
} keys_buf;

layout(set = 0, binding = 1, std430) readonly buffer Values {
  VALUE_T data[];
} values_buf;

layout(set = 0, binding = 2, std430) readonly buffer Partial {
  int data[];
} partial_buf;

layout(set = 0, binding = 3, std430) readonly buffer Offsets {
  int data[];
} offsets_buf;

layout(set = 0, binding = 4, std430) buffer Output {
  VALUE_T data[];
} output_buf;

shared int local_cursor[4096];

void main() {
  const uint chunk_size = 2048u;
  uint lid = gl_LocalInvocationID.x;
  uint chunk = bucket_group_index();
  if (chunk >= params.chunks) {
    return;
  }
  uint n = params.n;
  uint item_words = params.item_words;
  uint num_bins = params.bins;

  for (uint bin = lid; bin < num_bins; bin += 256u) {
    local_cursor[bin] = 0;
  }
  barrier();

  uint base = chunk * chunk_size;
  for (uint offset = lid; offset < chunk_size; offset += 256u) {
    uint idx = base + offset;
    if (idx < n) {
      int key = keys_buf.data[params.keys_offset + idx * params.keys_stride];
      if (key >= 0 && uint(key) < num_bins) {
        uint bin = uint(key);
        uint local_rank = uint(atomicAdd(local_cursor[bin], 1));
        uint chunk_base =
            uint(partial_buf.data[chunk * num_bins + bin]);
        uint bucket_base = uint(offsets_buf.data[
            params.offsets_offset + bin * params.offsets_stride]);
        uint out_idx = bucket_base + chunk_base + local_rank;
#if VALUE_KIND == 7
        uint dst_base = params.output_offset + out_idx * params.output_stride;
        uint src_base = params.values_offset + idx * params.values_stride;
        if (out_idx < params.n) {
          for (uint lane = 0u; lane < item_words; ++lane) {
            output_buf.data[dst_base + lane] =
                values_buf.data[src_base + lane];
          }
        }
#else
        if (out_idx < params.n) {
          output_buf.data[params.output_offset + out_idx * params.output_stride] =
              values_buf.data[params.values_offset + idx * params.values_stride];
        }
#endif
      }
    }
  }
}
