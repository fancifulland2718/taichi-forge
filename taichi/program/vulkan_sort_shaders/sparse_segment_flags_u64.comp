#version 450
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Keys {
  uint64_t keys[];
};
layout(set = 0, binding = 1) writeonly buffer SegmentIds {
  int segment_ids[];
};
layout(set = 0, binding = 2) readonly buffer ActiveCount {
  int active_count[];
};
layout(set = 0, binding = 3) buffer Control {
  int control[];
};

layout(push_constant) uniform Params {
  uint n;
  uint reserved0;
  uint reserved1;
  uint reserved2;
} params;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= params.n) {
    return;
  }
  int active_items = active_count[0];
  if (active_items < 0 || uint(active_items) > params.n) {
    if (i == 0u) {
      atomicCompSwap(control[0], 0, -4);
    }
    segment_ids[i] = 0;
    return;
  }
  segment_ids[i] =
      i < uint(active_items) && (i == 0u || keys[i] != keys[i - 1u]) ? 1 : 0;
}
