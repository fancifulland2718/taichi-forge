#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 1
#define VALUE_T float
#define ZERO_VALUE 0.0
#elif VALUE_KIND == 2
#define VALUE_T uint
#define ZERO_VALUE 0u
#else
#define VALUE_T int
#define ZERO_VALUE 0
#endif

layout(set = 0, binding = 0, std430) buffer Data {
  VALUE_T data[];
} data_buf;

#ifdef STRIDED_SOURCE
layout(set = 0, binding = 1, std430) readonly buffer ScanParams {
  uint n;
  uint data_offset_words;
  uint data_stride_words;
} params_buf;
#endif

shared VALUE_T scratch[256];
shared VALUE_T carry;

uint value_count() {
#ifdef STRIDED_SOURCE
  return params_buf.n;
#else
  return data_buf.data.length();
#endif
}

uint physical_index(uint logical_index) {
#ifdef REVERSE_SCAN
  uint n = value_count();
  return n - 1u - logical_index;
#else
  return logical_index;
#endif
}

VALUE_T load_value(uint logical_index) {
  uint data_index = physical_index(logical_index);
#ifdef STRIDED_SOURCE
  uint word_index =
      params_buf.data_offset_words + data_index * params_buf.data_stride_words;
  return data_buf.data[word_index];
#else
  return data_buf.data[data_index];
#endif
}

void store_value(uint logical_index, VALUE_T value) {
  uint data_index = physical_index(logical_index);
#ifdef STRIDED_SOURCE
  uint word_index =
      params_buf.data_offset_words + data_index * params_buf.data_stride_words;
  data_buf.data[word_index] = value;
#else
  data_buf.data[data_index] = value;
#endif
}

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint n = value_count();

  if (lid == 0u) {
    carry = ZERO_VALUE;
  }
  barrier();

  for (uint base = 0u; base < n; base += 256u) {
    uint idx = base + lid;
    VALUE_T value = idx < n ? load_value(idx) : ZERO_VALUE;

    if (gl_NumSubgroups <= gl_SubgroupSize) {
      uint subgroup = gl_SubgroupID;
      uint lane = gl_SubgroupInvocationID;
      VALUE_T inclusive = subgroupInclusiveAdd(value);
      VALUE_T total = subgroupAdd(value);
      if (subgroupElect()) {
        scratch[subgroup] = total;
      }
      barrier();

      if (subgroup == 0u) {
        VALUE_T subgroup_sum =
            lane < gl_NumSubgroups ? scratch[lane] : ZERO_VALUE;
        VALUE_T subgroup_prefix =
            subgroupInclusiveAdd(subgroup_sum) - subgroup_sum;
        if (lane < gl_NumSubgroups) {
          scratch[lane] = subgroup_prefix;
        }
      }
      barrier();
      value = inclusive + scratch[subgroup];
    } else {
      scratch[lid] = value;
      barrier();
      for (uint step = 1u; step < 256u; step <<= 1u) {
        VALUE_T addend = lid >= step ? scratch[lid - step] : ZERO_VALUE;
        barrier();
        scratch[lid] += addend;
        barrier();
      }
      value = scratch[lid];
    }

    value += carry;
    if (idx < n) {
      store_value(idx, value);
    }
    barrier();
    if (lid == 255u) {
      carry = value;
    }
    barrier();
  }
}
