#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Data {
  int data[];
} data_buf;

shared int scratch[256];
shared int carry;

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint n = data_buf.data.length();

  if (lid == 0u) {
    carry = 0;
  }
  barrier();

  for (uint base = 0u; base < n; base += 256u) {
    uint idx = base + lid;
    int value = idx < n ? data_buf.data[idx] : 0;

    if (gl_NumSubgroups <= gl_SubgroupSize) {
      uint subgroup = gl_SubgroupID;
      uint lane = gl_SubgroupInvocationID;
      int inclusive = subgroupInclusiveAdd(value);
      int total = subgroupAdd(value);
      if (subgroupElect()) {
        scratch[subgroup] = total;
      }
      barrier();

      if (subgroup == 0u) {
        int subgroup_sum = lane < gl_NumSubgroups ? scratch[lane] : 0;
        int subgroup_prefix = subgroupInclusiveAdd(subgroup_sum) - subgroup_sum;
        if (lane < gl_NumSubgroups) {
          scratch[lane] = subgroup_prefix;
        }
      }
      barrier();
      value = inclusive + scratch[subgroup];
    } else {
      scratch[lid] = value;
      barrier();
      for (uint step = 1u; step < 256u; step <<= 1u) {
        int addend = lid >= step ? scratch[lid - step] : 0;
        barrier();
        scratch[lid] += addend;
        barrier();
      }
      value = scratch[lid];
    }

    value += carry;
    if (idx < n) {
      data_buf.data[idx] = value;
    }
    barrier();
    if (lid == 255u) {
      carry = value;
    }
    barrier();
  }
}
