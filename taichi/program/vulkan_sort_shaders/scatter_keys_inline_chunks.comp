#version 450

#ifndef SHIFT
#define SHIFT 0
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer KeysIn {
  uint data[];
} keys_in;

layout(set = 0, binding = 1, std430) writeonly buffer KeysOut {
  uint data[];
} keys_out;

layout(set = 0, binding = 2, std430) readonly buffer Ranks {
  uint data[];
} ranks;

layout(set = 0, binding = 3, std430) readonly buffer Offsets {
  uint data[];
} offsets;

layout(set = 0, binding = 4, std430) readonly buffer ChunkSums {
  uint data[];
} chunk_sums;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= keys_in.data.length()) {
    return;
  }
  uint key = keys_in.data[i];
  uint digit = (key >> SHIFT) & 15u;
  uint block = i / 256u;
  uint chunk = block / 256u;
  uint chunks = chunk_sums.data.length() / 16u;

  uint chunk_offset = 0u;
  for (uint bin = 0u; bin < digit; ++bin) {
    for (uint c = 0u; c < chunks; ++c) {
      chunk_offset += chunk_sums.data[c * 16u + bin];
    }
  }
  for (uint c = 0u; c < chunk; ++c) {
    chunk_offset += chunk_sums.data[c * 16u + digit];
  }

  uint pos = chunk_offset + offsets.data[block * 16u + digit] + ranks.data[i];
  keys_out.data[pos] = key;
}
