#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Values {
  int data[];
} values_buf;

layout(set = 0, binding = 1, std430) buffer Bins {
  int data[];
} bins_buf;

layout(set = 0, binding = 2, std430) buffer Partial {
  int data[];
} partial_buf;

shared int local_hist[512];

void main() {
  const uint chunk_size = 2048u;
  uint lid = gl_LocalInvocationID.x;
  uint chunk = gl_WorkGroupID.x;
  uint n = values_buf.data.length();
  uint num_bins = bins_buf.data.length();

  for (uint bin = lid; bin < num_bins; bin += 256u) {
    local_hist[bin] = 0;
  }
  barrier();

  uint base = chunk * chunk_size;
  for (uint offset = lid; offset < chunk_size; offset += 256u) {
    uint idx = base + offset;
    if (idx < n) {
      int bin = values_buf.data[idx];
      if (bin >= 0 && uint(bin) < num_bins) {
        atomicAdd(local_hist[uint(bin)], 1);
      }
    }
  }
  barrier();

  for (uint bin = lid; bin < num_bins; bin += 256u) {
    partial_buf.data[chunk * num_bins + bin] = local_hist[bin];
  }
}
