#version 450

layout(local_size_x = 256) in;

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#ifndef BIN_KIND
#define BIN_KIND 0
#endif

#if BIN_KIND == 4
#extension GL_ARB_gpu_shader_int64 : require
#define BIN_T int64_t
#else
#define BIN_T int
#endif

#if VALUE_KIND == 2
#define VALUE_T uint
#else
#define VALUE_T int
#endif

layout(set = 0, binding = 0, std430) buffer Values {
  VALUE_T data[];
} values_buf;

layout(set = 0, binding = 1, std430) buffer Bins {
  BIN_T data[];
} bins_buf;

layout(set = 0, binding = 2, std430) buffer Partial {
  BIN_T data[];
} partial_buf;

shared int local_hist[512];

void main() {
  const uint chunk_size = 2048u;
  uint lid = gl_LocalInvocationID.x;
  uint chunk = gl_WorkGroupID.x;
  uint n = values_buf.data.length();
  uint num_bins = bins_buf.data.length();

  for (uint bin = lid; bin < num_bins; bin += 256u) {
    local_hist[bin] = 0;
  }
  barrier();

  uint base = chunk * chunk_size;
  for (uint offset = lid; offset < chunk_size; offset += 256u) {
    uint idx = base + offset;
    if (idx < n) {
#if VALUE_KIND == 2
      uint bin = values_buf.data[idx];
      if (bin < num_bins) {
        atomicAdd(local_hist[bin], 1);
      }
#else
      VALUE_T bin = values_buf.data[idx];
      if (bin >= 0 && uint(bin) < num_bins) {
        atomicAdd(local_hist[uint(bin)], 1);
      }
#endif
    }
  }
  barrier();

  for (uint bin = lid; bin < num_bins; bin += 256u) {
    partial_buf.data[chunk * num_bins + bin] = BIN_T(local_hist[bin]);
  }
}
