#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer State {
  uint words[];
} state_buf;
layout(set = 0, binding = 1, std430) readonly buffer Residual {
  float data[];
} residual_buf;
layout(set = 0, binding = 2, std430) readonly buffer Direction {
  float data[];
} direction_buf;
layout(set = 0, binding = 3, std430) readonly buffer AppliedDirection {
  float data[];
} applied_direction_buf;
layout(set = 0, binding = 4, std430) readonly buffer Solution {
  float data[];
} solution_buf;
layout(set = 0, binding = 5, std430) writeonly buffer CandidateSolution {
  float data[];
} candidate_buf;
layout(set = 0, binding = 6, std430) writeonly buffer IntermediateResidual {
  float data[];
} intermediate_buf;

layout(push_constant) uniform Params {
  uint n;
  uint unused0;
  uint unused1;
  uint unused2;
} params;

const uint ALPHA = 6u;
const uint STATUS = 16u;
const uint ACTION = 18u;
const uint STATUS_ACTIVE = 0u;
const uint ACTION_NORMAL = 0u;

void main() {
  if (state_buf.words[STATUS] != STATUS_ACTIVE ||
      state_buf.words[ACTION] != ACTION_NORMAL) {
    return;
  }
  float alpha = uintBitsToFloat(state_buf.words[ALPHA]);
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint index = gl_GlobalInvocationID.x;
  while (index < params.n) {
    candidate_buf.data[index] =
        solution_buf.data[index] + alpha * direction_buf.data[index];
    intermediate_buf.data[index] =
        residual_buf.data[index] -
        alpha * applied_direction_buf.data[index];
    if (params.n - index <= stride) {
      break;
    }
    index += stride;
  }
}
