#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer KeysIn {
  uint data[];
} keys_in;

layout(set = 0, binding = 1, std430) writeonly buffer KeysOut {
  int data[];
} keys_out;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= keys_in.data.length()) {
    return;
  }
  keys_out.data[i] = int(keys_in.data[i] ^ 0x80000000u);
}
