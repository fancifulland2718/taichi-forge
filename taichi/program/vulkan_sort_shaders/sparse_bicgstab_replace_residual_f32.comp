#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer State {
  uint words[];
} state_buf;
layout(set = 0, binding = 1, std430) readonly buffer TrueResidual {
  float data[];
} true_residual_buf;
layout(set = 0, binding = 2, std430) writeonly buffer Residual {
  float data[];
} residual_buf;

layout(push_constant) uniform Params {
  uint n;
  uint unused0;
  uint unused1;
  uint unused2;
} params;

const uint ACTION = 18u;
const uint ACTION_NORMAL = 0u;

void main() {
  if (state_buf.words[ACTION] != ACTION_NORMAL) {
    return;
  }
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint index = gl_GlobalInvocationID.x;
  while (index < params.n) {
    residual_buf.data[index] = true_residual_buf.data[index];
    if (params.n - index <= stride) {
      break;
    }
    index += stride;
  }
}
