#version 450

layout(local_size_x = 256) in;
layout(push_constant) uniform HistogramParams {
  uint n;
  uint num_bins;
  uint values_offset;
  uint bins_offset;
  uint num_chunks;
} params;


#ifndef BIN_KIND
#define BIN_KIND 0
#endif

#if BIN_KIND == 4
#extension GL_ARB_gpu_shader_int64 : require
#define BIN_T int64_t
#else
#define BIN_T int
#endif

layout(set = 0, binding = 0, std430) buffer Data {
  BIN_T data[];
} data_buf;

void main() {
  uint idx = gl_GlobalInvocationID.x;
  if (idx < params.n) {
    data_buf.data[params.bins_offset + idx] = BIN_T(0);
  }
}
