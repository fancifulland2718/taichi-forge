#version 450

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 3 || VALUE_KIND == 4
#extension GL_ARB_gpu_shader_int64 : require
#elif VALUE_KIND == 5
#extension GL_ARB_gpu_shader_fp64 : require
#endif

#if VALUE_KIND == 1
#define VALUE_T float
#elif VALUE_KIND == 2
#define VALUE_T uint
#elif VALUE_KIND == 3
#define VALUE_T uint64_t
#elif VALUE_KIND == 4
#define VALUE_T int64_t
#elif VALUE_KIND == 5
#define VALUE_T double
#else
#define VALUE_T int
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Output {
  VALUE_T data[];
} output_buf;

#ifdef STRIDED_DEST
layout(set = 0, binding = 1, std430) readonly buffer Params {
  uint n;
  uint output_offset_items;
  uint output_stride_items;
} params_buf;

uint output_count() {
  return params_buf.n;
}

uint output_index(uint i) {
  return params_buf.output_offset_items + i * params_buf.output_stride_items;
}
#else
uint output_count() {
  return uint(output_buf.data.length());
}

uint output_index(uint i) {
  return i;
}
#endif

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= output_count()) {
    return;
  }
  output_buf.data[output_index(i)] = VALUE_T(0);
}
