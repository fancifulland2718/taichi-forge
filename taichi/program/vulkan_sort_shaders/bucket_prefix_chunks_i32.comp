#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256) in;
#include "bucket_params.glsl"

layout(set = 0, binding = 0, std430) buffer Partial {
  int data[];
} partial_buf;

layout(set = 0, binding = 1, std430) buffer Offsets {
  int data[];
} offsets_buf;

void main() {
  uint bin = bucket_item_index();
  uint num_bins = params.bins;
  if (bin >= num_bins) {
    return;
  }
  uint chunks = params.chunks;
  int running = 0;
  for (uint chunk = 0u; chunk < chunks; ++chunk) {
    uint idx = chunk * num_bins + bin;
    int count = partial_buf.data[idx];
    partial_buf.data[idx] = running;
    running += count;
  }
  if (bin == 0u) {
    offsets_buf.data[params.offsets_offset] = 0;
  }
  offsets_buf.data[params.offsets_offset + (bin + 1u) * params.offsets_stride] = running;
}
