#version 450
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Keys {
  uint64_t keys[];
};
layout(set = 0, binding = 1) readonly buffer SegmentIds {
  int segment_ids[];
};
layout(set = 0, binding = 2) writeonly buffer UniqueKeys {
  uint64_t unique_keys[];
};
layout(set = 0, binding = 3) writeonly buffer SegmentOffsets {
  int segment_offsets[];
};
layout(set = 0, binding = 4) readonly buffer ActiveCount {
  int active_count[];
};
layout(set = 0, binding = 5) buffer Control {
  int control[];
};

layout(push_constant) uniform Params {
  uint n;
  uint reserved0;
  uint reserved1;
  uint reserved2;
} params;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= params.n) {
    return;
  }
  int active_items = active_count[0];
  if (active_items < 0 || uint(active_items) > params.n) {
    if (i == 0u) {
      atomicCompSwap(control[0], 0, -4);
      control[1] = 0;
    }
    return;
  }
  if (active_items == 0) {
    if (i == 0u) {
      segment_offsets[0] = 0;
      if (control[0] == 0) {
        control[1] = 0;
      }
    }
    return;
  }
  if (i >= uint(active_items)) {
    return;
  }
  bool is_start = i == 0u || keys[i] != keys[i - 1u];
  int segment = segment_ids[i] - 1;
  if (is_start) {
    if (segment < 0 || segment >= active_items) {
      atomicCompSwap(control[0], 0, -4);
    } else {
      unique_keys[segment] = keys[i];
      segment_offsets[segment] = int(i);
    }
  }
  if (i + 1u == uint(active_items)) {
    int count = segment + 1;
    if (count <= 0 || count > active_items) {
      atomicCompSwap(control[0], 0, -4);
      control[1] = 0;
    } else {
      segment_offsets[count] = active_items;
      control[1] = count;
    }
  }
}
