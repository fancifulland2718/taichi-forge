#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer State {
  uint words[];
} state_buf;
layout(set = 0, binding = 1, std430) buffer VOld {
  float data[];
} v_old_buf;
layout(set = 0, binding = 2, std430) buffer V {
  float data[];
} v_buf;
layout(set = 0, binding = 3, std430) readonly buffer VNew {
  float data[];
} v_new_buf;

layout(push_constant) uniform Params {
  uint n;
  uint unused0;
  uint unused1;
  uint unused2;
} params;

const uint BETA_NEW = 9u;
const uint STATUS = 20u;
const uint ACTION = 22u;
const uint STATUS_ACTIVE = 0u;
const uint ACTION_NORMAL = 0u;

void main() {
  if (state_buf.words[STATUS] != STATUS_ACTIVE ||
      state_buf.words[ACTION] != ACTION_NORMAL) {
    return;
  }
  float beta_new = uintBitsToFloat(state_buf.words[BETA_NEW]);
  if (beta_new == 0.0) {
    return;
  }
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint index = gl_GlobalInvocationID.x;
  while (index < params.n) {
    v_old_buf.data[index] = v_buf.data[index];
    v_buf.data[index] = v_new_buf.data[index] / beta_new;
    if (params.n - index <= stride) {
      break;
    }
    index += stride;
  }
}
