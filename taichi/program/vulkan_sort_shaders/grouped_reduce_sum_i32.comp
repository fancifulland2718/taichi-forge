#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 3 || VALUE_KIND == 4
#extension GL_ARB_gpu_shader_int64 : require
#elif VALUE_KIND == 5
#extension GL_ARB_gpu_shader_fp64 : require
#endif

#if VALUE_KIND == 1
#define VALUE_T float
#elif VALUE_KIND == 2
#define VALUE_T uint
#elif VALUE_KIND == 3
#define VALUE_T uint64_t
#elif VALUE_KIND == 4
#define VALUE_T int64_t
#elif VALUE_KIND == 5
#define VALUE_T double
#else
#define VALUE_T int
#endif

layout(set = 0, binding = 0) readonly buffer Offsets {
  int offsets[];
};

layout(set = 0, binding = 1) readonly buffer Values {
  VALUE_T values[];
};

layout(set = 0, binding = 2) writeonly buffer Output {
  VALUE_T output_values[];
};

shared VALUE_T partial[256];

void main() {
  uint group = gl_WorkGroupID.x;
  uint lid = gl_LocalInvocationID.x;
  int begin = offsets[group];
  int end = offsets[group + 1];
  VALUE_T acc = VALUE_T(0);
  for (int i = begin + int(lid); i < end; i += 256) {
    acc += values[i];
  }
  partial[lid] = acc;
  barrier();

  for (uint stride = 128; stride > 0; stride >>= 1) {
    if (lid < stride) {
      partial[lid] += partial[lid + stride];
    }
    barrier();
  }
  if (lid == 0) {
    output_values[group] = partial[0];
  }
}
