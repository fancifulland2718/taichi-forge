#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Src {
  double data[];
} src_buf;

layout(set = 0, binding = 1, std430) writeonly buffer Dst {
  double data[];
} dst_buf;

layout(set = 0, binding = 2, std430) readonly buffer Params {
  double scale;
  double bias;
} params;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= src_buf.data.length()) {
    return;
  }
  dst_buf.data[i] = src_buf.data[i] * params.scale + params.bias;
}
