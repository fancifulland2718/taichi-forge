#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Src {
  double data[];
} src_buf;

layout(set = 0, binding = 1, std430) writeonly buffer Dst {
  double data[];
} dst_buf;

layout(set = 0, binding = 2, std430) readonly buffer Params {
  double scale;
  double bias;
  uint n;
  uint src_offset_words;
  uint src_stride_words;
  uint dst_offset_words;
  uint dst_stride_words;
} params;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= params.n) {
    return;
  }
  uint src_index = (params.src_offset_words + i * params.src_stride_words) / 2u;
  uint dst_index = (params.dst_offset_words + i * params.dst_stride_words) / 2u;
  dst_buf.data[dst_index] = src_buf.data[src_index] * params.scale + params.bias;
}
