#version 450

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 1
#extension GL_EXT_shader_atomic_float : require
#define VALUE_T float
#elif VALUE_KIND == 2
#define VALUE_T uint
#elif VALUE_KIND == 3
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#define VALUE_T uint64_t
#elif VALUE_KIND == 4
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#define VALUE_T int64_t
#elif VALUE_KIND == 5
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_atomic_float : require
#define VALUE_T double
#else
#define VALUE_T int
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Keys {
  int data[];
} keys_buf;

layout(set = 0, binding = 1, std430) readonly buffer Values {
  VALUE_T data[];
} values_buf;

layout(set = 0, binding = 2, std430) buffer Output {
  VALUE_T data[];
} output_buf;

#ifdef STRIDED_SOURCE
layout(push_constant) uniform Params {
  uint n;
  uint keys_offset_items;
  uint keys_stride_items;
  uint values_offset_items;
  uint values_stride_items;
  uint output_count;
  uint output_offset_items;
  uint output_stride_items;
} params_buf;

uint value_count() {
  return params_buf.n;
}

VALUE_T load_value(uint i) {
  return values_buf.data[params_buf.values_offset_items + i * params_buf.values_stride_items];
}

int load_key(uint i) {
  return keys_buf.data[params_buf.keys_offset_items + i * params_buf.keys_stride_items];
}

uint group_count() {
  return params_buf.output_count;
}

uint output_index(uint group) {
  return params_buf.output_offset_items + group * params_buf.output_stride_items;
}
#else
uint value_count() {
  return uint(keys_buf.data.length());
}

VALUE_T load_value(uint i) {
  return values_buf.data[i];
}

int load_key(uint i) {
  return keys_buf.data[i];
}

uint group_count() {
  return uint(output_buf.data.length());
}

uint output_index(uint group) {
  return group;
}
#endif

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= value_count()) {
    return;
  }
  int key = load_key(i);
  uint group = uint(key);
  if (key < 0 || group >= group_count()) {
    return;
  }
  atomicAdd(output_buf.data[output_index(group)], load_value(i));
}
