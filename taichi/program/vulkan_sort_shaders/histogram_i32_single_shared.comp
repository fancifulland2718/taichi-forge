#version 450

layout(local_size_x = 256) in;

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 2
#define VALUE_T uint
#else
#define VALUE_T int
#endif

layout(set = 0, binding = 0, std430) buffer Values {
  VALUE_T data[];
} values_buf;

layout(set = 0, binding = 1, std430) buffer Bins {
  int data[];
} bins_buf;

shared int local_hist[4096];

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint n = values_buf.data.length();
  uint num_bins = bins_buf.data.length();

  for (uint bin = lid; bin < num_bins; bin += 256u) {
    local_hist[bin] = 0;
  }
  barrier();

  for (uint idx = lid; idx < n; idx += 256u) {
#if VALUE_KIND == 2
    uint bin = values_buf.data[idx];
    if (bin < num_bins) {
      atomicAdd(local_hist[bin], 1);
    }
#else
    VALUE_T bin = values_buf.data[idx];
    if (bin >= 0 && uint(bin) < num_bins) {
      atomicAdd(local_hist[uint(bin)], 1);
    }
#endif
  }
  barrier();

  for (uint bin = lid; bin < num_bins; bin += 256u) {
    bins_buf.data[bin] = local_hist[bin];
  }
}
