#version 450

layout(local_size_x = 256) in;
layout(push_constant) uniform HistogramParams {
  uint n;
  uint num_bins;
  uint values_offset;
  uint bins_offset;
  uint num_chunks;
} params;


#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 2
#define VALUE_T uint
#else
#define VALUE_T int
#endif

layout(set = 0, binding = 0, std430) buffer Values {
  VALUE_T data[];
} values_buf;

layout(set = 0, binding = 1, std430) buffer Bins {
  int data[];
} bins_buf;

shared int local_hist[4096];

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint n = params.n;
  uint num_bins = params.num_bins;

  for (uint bin = lid; bin < num_bins; bin += 256u) {
    local_hist[bin] = 0;
  }
  barrier();

  for (uint idx = lid; idx < n; idx += 256u) {
#if VALUE_KIND == 2
    uint bin = values_buf.data[params.values_offset + idx];
    if (bin < num_bins) {
      atomicAdd(local_hist[bin], 1);
    }
#else
    VALUE_T bin = values_buf.data[params.values_offset + idx];
    if (bin >= 0 && uint(bin) < num_bins) {
      atomicAdd(local_hist[uint(bin)], 1);
    }
#endif
  }
  barrier();

  for (uint bin = lid; bin < num_bins; bin += 256u) {
    bins_buf.data[params.bins_offset + bin] = local_hist[bin];
  }
}
