#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256) in;
#include "bucket_params.glsl"

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 7
#define VALUE_T uint
#elif VALUE_KIND == 6
#define VALUE_T uvec2
#elif VALUE_KIND == 2
#define VALUE_T uint
#elif VALUE_KIND == 1
#define VALUE_T float
#else
#define VALUE_T int
#endif

layout(set = 0, binding = 0, std430) readonly buffer Keys {
  int data[];
} keys_buf;

layout(set = 0, binding = 1, std430) readonly buffer Values {
  VALUE_T data[];
} values_buf;

layout(set = 0, binding = 2, std430) buffer Cursor {
  int data[];
} cursor_buf;

layout(set = 0, binding = 3, std430) buffer Output {
  VALUE_T data[];
} output_buf;

void main() {
  uint idx = bucket_item_index();
  if (idx >= params.n) {
    return;
  }
  int key = keys_buf.data[params.keys_offset + idx * params.keys_stride];
  if (key < 0 || uint(key) >= params.bins) {
    return;
  }
  uint out_idx = uint(atomicAdd(cursor_buf.data[params.cursor_offset + uint(key)], 1));
#if VALUE_KIND == 7
  uint item_words = params.item_words;
  uint dst_base = params.output_offset + out_idx * params.output_stride;
  uint src_base = params.values_offset + idx * params.values_stride;
  if (out_idx < params.n) {
    for (uint lane = 0u; lane < item_words; ++lane) {
      output_buf.data[dst_base + lane] = values_buf.data[src_base + lane];
    }
  }
#else
  if (out_idx < params.n) {
    output_buf.data[params.output_offset + out_idx * params.output_stride] =
        values_buf.data[params.values_offset + idx * params.values_stride];
  }
#endif
}
