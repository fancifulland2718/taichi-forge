#version 450

layout(local_size_x = 256) in;

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 7
#define VALUE_T uint
#elif VALUE_KIND == 6
#define VALUE_T uvec2
#elif VALUE_KIND == 2
#define VALUE_T uint
#elif VALUE_KIND == 1
#define VALUE_T float
#else
#define VALUE_T int
#endif

layout(set = 0, binding = 0, std430) readonly buffer Keys {
  int data[];
} keys_buf;

layout(set = 0, binding = 1, std430) readonly buffer Values {
  VALUE_T data[];
} values_buf;

layout(set = 0, binding = 2, std430) buffer Cursor {
  int data[];
} cursor_buf;

layout(set = 0, binding = 3, std430) buffer Output {
  VALUE_T data[];
} output_buf;

void main() {
  uint idx = gl_GlobalInvocationID.x;
  if (idx >= keys_buf.data.length()) {
    return;
  }
  int key = keys_buf.data[idx];
  if (key < 0 || uint(key) >= cursor_buf.data.length()) {
    return;
  }
  uint out_idx = uint(atomicAdd(cursor_buf.data[uint(key)], 1));
#if VALUE_KIND == 7
  uint n = keys_buf.data.length();
  uint item_words = n == 0u ? 0u : values_buf.data.length() / n;
  uint dst_base = out_idx * item_words;
  uint src_base = idx * item_words;
  if (item_words > 0u &&
      dst_base + item_words <= output_buf.data.length() &&
      src_base + item_words <= values_buf.data.length()) {
    for (uint lane = 0u; lane < item_words; ++lane) {
      output_buf.data[dst_base + lane] = values_buf.data[src_base + lane];
    }
  }
#else
  if (out_idx < output_buf.data.length()) {
    output_buf.data[out_idx] = values_buf.data[idx];
  }
#endif
}
