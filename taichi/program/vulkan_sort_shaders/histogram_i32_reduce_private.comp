#version 450

layout(local_size_x = 256) in;

#ifndef BIN_KIND
#define BIN_KIND 0
#endif

#if BIN_KIND == 4
#extension GL_ARB_gpu_shader_int64 : require
#define BIN_T int64_t
#else
#define BIN_T int
#endif

layout(set = 0, binding = 0, std430) buffer Partial {
  BIN_T data[];
} partial_buf;

layout(set = 0, binding = 1, std430) buffer Bins {
  BIN_T data[];
} bins_buf;

void main() {
  uint bin = gl_GlobalInvocationID.x;
  uint num_bins = bins_buf.data.length();
  if (bin >= num_bins) {
    return;
  }
  uint num_chunks = partial_buf.data.length() / num_bins;
  BIN_T total = BIN_T(0);
  for (uint chunk = 0u; chunk < num_chunks; ++chunk) {
    total += partial_buf.data[chunk * num_bins + bin];
  }
  bins_buf.data[bin] = total;
}
