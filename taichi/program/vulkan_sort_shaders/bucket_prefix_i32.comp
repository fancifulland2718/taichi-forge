#version 450

layout(local_size_x = 1) in;

layout(set = 0, binding = 0, std430) buffer Offsets {
  int data[];
} offsets_buf;

layout(set = 0, binding = 1, std430) buffer Cursor {
  int data[];
} cursor_buf;

void main() {
  int running = 0;
  uint num_offsets = offsets_buf.data.length();
  uint num_bins = cursor_buf.data.length();
  for (uint i = 0u; i < num_offsets; ++i) {
    running += offsets_buf.data[i];
    offsets_buf.data[i] = running;
    if (i < num_bins) {
      cursor_buf.data[i] = running;
    }
  }
}
