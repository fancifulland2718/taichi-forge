#version 450

layout(local_size_x = 256) in;

#ifndef VALUE_KIND
#define VALUE_KIND 0
#endif

#if VALUE_KIND == 3 || VALUE_KIND == 4
#extension GL_ARB_gpu_shader_int64 : require
#elif VALUE_KIND == 5
#extension GL_ARB_gpu_shader_fp64 : require
#endif

#if VALUE_KIND == 1
#define VALUE_T float
#elif VALUE_KIND == 2
#define VALUE_T uint
#elif VALUE_KIND == 3
#define VALUE_T uint64_t
#elif VALUE_KIND == 4
#define VALUE_T int64_t
#elif VALUE_KIND == 5
#define VALUE_T double
#else
#define VALUE_T int
#endif
#define ZERO_VALUE VALUE_T(0)

layout(set = 0, binding = 0, std430) buffer Data {
  VALUE_T data[];
} data_buf;

layout(set = 0, binding = 1, std430) buffer BlockSums {
  VALUE_T data[];
} block_sums;

#ifdef STRIDED_SOURCE
layout(set = 0, binding = 2, std430) readonly buffer ScanParams {
  uint n;
  uint data_offset_words;
  uint data_stride_words;
} params_buf;
#endif

shared VALUE_T scan[256];

uint value_count() {
#ifdef STRIDED_SOURCE
  return params_buf.n;
#else
  return data_buf.data.length();
#endif
}

VALUE_T load_value(uint logical_index) {
#ifdef STRIDED_SOURCE
  uint word_index =
      params_buf.data_offset_words + logical_index * params_buf.data_stride_words;
#if VALUE_KIND == 3 || VALUE_KIND == 4 || VALUE_KIND == 5
  return data_buf.data[word_index / 2u];
#else
  return data_buf.data[word_index];
#endif
#else
  return data_buf.data[logical_index];
#endif
}

void store_value(uint logical_index, VALUE_T value) {
#ifdef STRIDED_SOURCE
  uint word_index =
      params_buf.data_offset_words + logical_index * params_buf.data_stride_words;
#if VALUE_KIND == 3 || VALUE_KIND == 4 || VALUE_KIND == 5
  data_buf.data[word_index / 2u] = value;
#else
  data_buf.data[word_index] = value;
#endif
#else
  data_buf.data[logical_index] = value;
#endif
}

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint block = gl_WorkGroupID.x;
  uint idx = block * 256u + lid;
  uint n = value_count();
  uint blocks = (n + 255u) / 256u;

  VALUE_T value = idx < n ? load_value(idx) : ZERO_VALUE;
  scan[lid] = value;
  barrier();

  for (uint step = 1u; step < 256u; step <<= 1u) {
    VALUE_T addend = lid >= step ? scan[lid - step] : ZERO_VALUE;
    barrier();
    scan[lid] += addend;
    barrier();
  }

  if (idx < n) {
    store_value(idx, scan[lid]);
  }
  if (blocks > 1u && (lid == 255u || idx + 1u == n)) {
    block_sums.data[block] = scan[lid];
  }
}
