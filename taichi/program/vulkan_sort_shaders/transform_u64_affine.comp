#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Src {
  uint data[];
} src_buf;

layout(set = 0, binding = 1, std430) writeonly buffer Dst {
  uint data[];
} dst_buf;

layout(push_constant) uniform Params {
  uint scale_lo;
  uint scale_hi;
  uint bias_lo;
  uint bias_hi;
  uint n;
  uint src_offset_words;
  uint src_stride_words;
  uint dst_offset_words;
  uint dst_stride_words;
  uint lane_count;
} params;

uvec2 add64(uvec2 a, uvec2 b) {
  uint lo = a.x + b.x;
  uint carry = lo < a.x ? 1u : 0u;
  return uvec2(lo, a.y + b.y + carry);
}

uvec2 mul64(uvec2 a, uvec2 b) {
  uint lo = 0u;
  uint hi = 0u;
  umulExtended(a.x, b.x, hi, lo);
  hi += a.x * b.y + a.y * b.x;
  return uvec2(lo, hi);
}

void main() {
  uint scalar_i = gl_GlobalInvocationID.x;
  uint total = params.n * params.lane_count;
  if (scalar_i >= total) {
    return;
  }
  uint item = scalar_i / params.lane_count;
  uint lane = scalar_i - item * params.lane_count;
  uint lane_words = lane * 2u;
  uint src_base =
      params.src_offset_words + item * params.src_stride_words + lane_words;
  uint dst_base =
      params.dst_offset_words + item * params.dst_stride_words + lane_words;
  uvec2 value = uvec2(src_buf.data[src_base], src_buf.data[src_base + 1u]);
  uvec2 scale = uvec2(params.scale_lo, params.scale_hi);
  uvec2 bias = uvec2(params.bias_lo, params.bias_hi);
  uvec2 out_value = add64(mul64(value, scale), bias);
  dst_buf.data[dst_base] = out_value.x;
  dst_buf.data[dst_base + 1u] = out_value.y;
}
