#pragma once
#define TI_VERSION_MAJOR @TI_VERSION_MAJOR@
#define TI_VERSION_MINOR @TI_VERSION_MINOR@
#define TI_VERSION_PATCH @TI_VERSION_PATCH@
// Compatibility version of the slim libdevice bitcode bundled with this
// package. This must not use CUDA_VERSION: NVIDIA CUDA headers reserve that
// macro for their numeric toolkit version.
#define TI_CUDA_LIBDEVICE_VERSION "@TI_CUDA_LIBDEVICE_VERSION@"
